# StyleAI - Environment Variables Configuration Template

# Flask Environment (development, testing, production)
FLASK_ENV=production
SECRET_KEY=change-this-to-a-strong-random-production-secret-key
PORT=5000

# MongoDB Database Connection URI
MONGO_URI=mongodb://db:27017/faceshape

# JWT Secret & Expiry
JWT_SECRET=change-this-to-a-secure-jwt-signing-key
JWT_EXPIRY_HOURS=24

# Generative AI Key (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage & Limits
UPLOAD_FOLDER=server/uploads
MAX_CONTENT_LENGTH=10485760

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Virtual Try-On Provider (Replicate OpenAI GPT-Image-2.5-Flare)
TRYON_PROVIDER=replicate
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_MODEL=openai/gpt-image-2.5-flare
REPLICATE_QUALITY=low


# Alternative Virtual Try-On Provider (ComfyUI)
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=your_optional_comfyui_api_key
COMFYUI_WORKFLOW_PATH=workflow/sd1.5.json
COMFYUI_TIMEOUT=180
COMFYUI_POLL_INTERVAL=1.0

